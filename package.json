{
  "name": "aeo-scoring",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "check": "node scripts/repository-checks.mjs",
    "test": "node --test test/evaluation.test.mjs",
    "test:exit": "node --test test/exit.test.mjs",
    "evaluate": "node scripts/evaluate.mjs",
    "ci:gate": "node scripts/pr-gate.mjs",
    "ci:checks": "node scripts/ci-checks.mjs",
    "test:foundations": "node --test test/scoring-foundations.test.mjs",
    "test:feasibility": "node --test test/feasibility.test.mjs",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "test:preview": "node --test test/preview.test.mjs"
  },
  "dependencies": {
    "parse5": "^7.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.6"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
